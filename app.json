{
  "expo": {
    "name": "SyncVet",
    "slug": "syncvet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "syncvet",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syncvet.app"
    },
    "android": {
      "package": "com.syncvet.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A6E64",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/boy-child.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e4a17fe-9cdf-41e2-bb55-049b4789c107"
      }
    },
    "owner": "3hirdk"
  }
}
