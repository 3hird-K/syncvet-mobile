{
  "expo": {
    "name": "SyncVet",
    "slug": "syncvet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "syncvet",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syncvet.app"
    },
    "android": {
      "package": "com.syncvet.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A6E64",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F7B6E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo",
      "@clerk/expo-google-signin",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SyncVet to access your camera to scan pet tags, clinic queue, and barangay outreach QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SyncVet to access your photos to attach pet consultation photos and update your profile picture.",
          "cameraPermission": "Allow SyncVet to take photos of your pet during consultations.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F7B6E",
          "defaultChannel": "appointments",
          "enableRemoteNotifications": false
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "57333861088-0q20nqfhu5nu8bk7r68dfha9kksrvcvl.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID": "57333861088-nlqsp77toiq4t05bl33rrbfupehgkmc4.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "6e4a17fe-9cdf-41e2-bb55-049b4789c107"
      }
    },
    "owner": "3hirdk"
  }
}
